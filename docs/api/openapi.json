              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "uptime_seconds": {
            "type": "integer"
          },
          "database": {
            "type": "string",
            "enum": [
              "connected",
              "unavailable"
            ]
          },
          "rules_loaded": {
            "type": "integer"
          },
          "indicators_loaded": {
            "type": "integer"
          },
          "ai_available": {
            "type": "boolean"
          },
          "knowledge_available": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code",
          "hint"
