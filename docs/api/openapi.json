          "document_id",
          "title",
          "publisher",
          "url",
          "section",
          "page_numbers",
          "document_date"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "section": {
            "type": "string"
          },
          "page_numbers": {
            "type": "string",
            "nullable": true
          },
          "document_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
