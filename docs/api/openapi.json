          "as_of",
          "vigilance",
          "supported_vigilance",
          "indicators",
          "missing_indicators",
          "triggered_rules",
          "alerts",
          "thresholds_status",
          "skipped_rules",
          "history_truncated"
        ],
        "properties": {
          "subject_id": {
            "type": "string"
          },
