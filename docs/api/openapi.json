            }
          },
          "triggered_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alerts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "last_updated": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "thresholds_status": {
            "type": "string",
            "enum": [
              "validated",
              "provisional",
              "illustrative",
              "not_applicable"
            ]
          },
          "skipped_rules": {
            "type": "array",
            "items": {
