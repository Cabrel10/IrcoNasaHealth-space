          },
          "indicator": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "data_class": {
            "type": "string",
            "enum": [
              "measured_real",
              "analog",
              "synthetic"
            ]
          },
          "context": {
            "type": "object"
          },
          "provenance": {
            "type": "object"
          },
          "quality": {
            "type": "object"
          }
        }
      }
    }
  }
